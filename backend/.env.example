# The app's own database (audit log, preferences, roles), like SmartHub's
# smarthub_core. Required. Tables are created in MONITORING_DB_SCHEMA on start.
# Copy an existing audit_log.db / rbac_config.json in once with:
#   python migrate_to_postgres.py --dry-run   then   python migrate_to_postgres.py
MONITORING_DB_DSN=host=<postgres-host> port=5432 dbname=<database> user=<user> password=<password> sslmode=require
MONITORING_DB_SCHEMA=monitoring_core

# Browser origins allowed to call this API (comma-separated, exact match).
# Required: with none set, every cross-origin browser request is refused.
ALLOWED_ORIGINS=https://gra-smarthub-dev.jnj.com:8080

# Microsoft Entra groups mapped to built-in roles (display name or object id).
AD_GROUP_ADMIN=JRD-APP-DEV-RDH-DQE-ITADMIN-USR
AD_GROUP_OPERATIONAL_SUPPORT=

# Pipeline agents: <PRODUCT>_AGENT_<ENV>_URL and _TOKEN for each agent you run.
# Products: EPOD (DEV, QA, PROD) and RIMDOCS (DEV, QA, PROD, DEV1, DEV2, QA2, PROD2).
EPOD_AGENT_DEV_URL=
EPOD_AGENT_DEV_TOKEN=
RIMDOCS_AGENT_DEV_URL=
RIMDOCS_AGENT_DEV_TOKEN=
# Set to false only for agents using a self-signed certificate.
AGENT_TLS_VERIFY=true

# Optional
# MONITORING_DB_POOL_MAX=10
# MONITORING_DB_STATEMENT_TIMEOUT_MS=30000
# EPOD_CONFIG_PATH=/path/to/config.ini
# DISPLAY_TIMEZONE=America/New_York
# DB_NAIVE_TIMEZONE=UTC
# STALL_THRESHOLD_MINS=30
# LOG_LEVEL=INFO
