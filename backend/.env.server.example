# Settings for linux_manage/backend.sh. Copy to .env.server and adjust.
# .env.server is not committed. App settings stay in .env.

# Port the frontend calls (VITE_API_BASE_URL).
PORT=8501

# HTTPS. Leave both empty to serve plain HTTP.
TLS_CERT=/home/sa-prd-rdi-react-dev/SSL2026/awsbjvnval002j_jnj_com_cert.pem
TLS_KEY=/home/sa-prd-rdi-react-dev/SSL2026/awsbjvnval002j_jnj_com_key.pem

# Optional. Defaults shown.
# PYTHON_BIN=<this folder>/venv/bin/python   created on first start if missing
# APP=Backend:app
# HOST=0.0.0.0
# START_TIMEOUT=120         seconds the app may take to answer before start gives up
# GRACEFUL_TIMEOUT=30       seconds in-flight requests get on stop
# FORWARDED_ALLOW_IPS=127.0.0.1   proxies trusted for the client address
# ACCESS_LOG=1
# LOG_MAX_MB=50
# LOG_KEEP=5
