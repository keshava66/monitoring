# Settings for linux_manage/frontend.sh. Copy to .env.server and adjust.
# .env.server is not committed. Build settings stay in .env.

# Port users open in the browser. Must match the redirect URI registered in Azure.
PORT=8502

# Full paths: cron runs with a short PATH (`which node`, `which npm`).
NODE_BIN=/usr/bin/node
NPM_BIN=/usr/bin/npm

# HTTPS. Leave both empty to serve plain HTTP.
TLS_CERT=/home/sa-prd-rdi-react-dev/SSL2026/awsbjvnval002j_jnj_com_cert.pem
TLS_KEY=/home/sa-prd-rdi-react-dev/SSL2026/awsbjvnval002j_jnj_com_key.pem

# Optional. Defaults shown.
# HOST=0.0.0.0
# START_TIMEOUT=30
# GRACEFUL_TIMEOUT=30
# SUPERVISOR_PYTHON=/usr/bin/python3
# LOG_MAX_MB=50
# LOG_KEEP=5
