# Microsoft Entra group(s) whose members may use this panel (display name or
# object id, comma-separated). Empty = every request is rejected.
AD_GROUP_ADMIN=JRD-APP-DEV-RDH-DQE-ITADMIN-USR

# Browser origins allowed to call this panel (comma-separated, exact match).
ALLOWED_ORIGINS=https://gra-smarthub-dev.jnj.com:8080

# Optional: git credentials for /api/gitpull and the terminal (override config.ini [repo]).
REPO_USERNAME=
REPO_PASSWORD=

# Optional: close idle terminal sessions after this many seconds (default 1800).
# TERMINAL_IDLE_SECONDS=1800
