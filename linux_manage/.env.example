# ── AUTH (required) ─────────────────────────────────────────────────────────
# Every request needs a valid Microsoft Graph token belonging to someone in
# this AD group. If left blank, every request is rejected — fails closed,
# not open.
AD_GROUP_ADMIN=JRD-APP-DEV-RDH-DQE-ITADMIN-USR

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this panel from the browser.
ALLOWED_ORIGINS=http://localhost:3000, https://gra-smarthub-dev.jnj.com:8080
