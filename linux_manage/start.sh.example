#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY_SYSTEM="${PYTHON_BIN:-python3}"
VENV_DIR="$DIR/venv"
PY="$VENV_DIR/bin/python"
LOG="$DIR/manager.log"
PID_FILE="$DIR/manager.pid"
CONFIG="$DIR/config.ini"
STARTUP_TIMEOUT=20

[ -f "$CONFIG" ] || { echo "FAILED: $CONFIG not found"; exit 1; }
PORT="$(awk -F= '/^\[manager\]/{s=1;next} /^\[/{s=0} s && $1 ~ /^[[:space:]]*port[[:space:]]*$/ {gsub(/[[:space:]]/,"",$2); print $2; exit}' "$CONFIG")"
PORT="${PORT:-8001}"
SCHEME=http
grep -qE '^[[:space:]]*certfile[[:space:]]*=[[:space:]]*[^[:space:]]' "$CONFIG" && SCHEME=https

if [ ! -x "$PY" ]; then
    echo "Creating virtual environment..."
    "$PY_SYSTEM" -m venv "$VENV_DIR"
fi
echo "Installing requirements..."
"$PY" -m pip install -q --disable-pip-version-check -r "$DIR/requirements.txt"

if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    OLD_PID="$(cat "$PID_FILE")"
    echo "Stopping existing manager (PID $OLD_PID)..."
    kill "$OLD_PID" 2>/dev/null || true
    for _ in $(seq 1 60); do kill -0 "$OLD_PID" 2>/dev/null || break; sleep 1; done
    if kill -0 "$OLD_PID" 2>/dev/null; then
        echo "Manager still running after 60s, killing it"
        kill -KILL "$OLD_PID" 2>/dev/null || true
        [ -f "${PID_FILE%.pid}.child.pid" ] && kill -KILL "$(cat "${PID_FILE%.pid}.child.pid")" 2>/dev/null || true
    fi
fi
rm -f "$PID_FILE" "${PID_FILE%.pid}.child.pid"

echo "Starting manager on :$PORT..."
# Under supervise.py the manager is restarted if it ever dies; its log is
# timestamped and rotated. 9>&- keeps nothing of this shell attached.
setsid "$PY" "$DIR/supervise.py" --name manager --pid-file "$PID_FILE" --log-file "$LOG" \
    -- "$PY" "$DIR/manage.py" >> "$DIR/manager.out" 2>&1 < /dev/null &
MANAGER_PID=$!

for _ in $(seq 1 "$STARTUP_TIMEOUT"); do
    sleep 1
    if curl -sfk "$SCHEME://localhost:$PORT/health" > /dev/null 2>&1; then
        echo "SUCCESS: manager running on :$PORT (PID $MANAGER_PID)"
        exit 0
    fi
    if ! kill -0 "$MANAGER_PID" 2>/dev/null; then
        echo "FAILED: manager exited. Last log lines:"
        tail -20 "$LOG"
        exit 1
    fi
done

echo "FAILED: manager did not respond on :$PORT within ${STARTUP_TIMEOUT}s."
tail -20 "$LOG"
kill "$MANAGER_PID" 2>/dev/null || true
exit 1
