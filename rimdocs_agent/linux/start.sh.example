#!/usr/bin/env bash
set -euo pipefail

AGENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$AGENT_DIR/venv"
PY="$VENV_DIR/bin/python"
REQUIREMENTS="$AGENT_DIR/requirements.txt"
LOG="$AGENT_DIR/agent.log"
PID_FILE="$AGENT_DIR/agent.pid"
CONFIG="$AGENT_DIR/config.ini"

[ -f "$CONFIG" ] || { echo "FAILED: $CONFIG not found"; exit 1; }

cfg() { grep -iE "^[[:space:]]*$1[[:space:]]*=" "$CONFIG" | head -1 | cut -d'=' -f2- | tr -d '[:space:]'; }
PORT="$(cfg PORT)"; PORT="${PORT:-8090}"
SCHEME=http; [ -n "$(cfg SSL_CERTFILE)" ] && SCHEME=https
HEALTH="$SCHEME://localhost:$PORT/health"

if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "Agent already running (PID $(cat "$PID_FILE")) on :$PORT"
    exit 0
fi

if [ ! -x "$PY" ]; then
    echo "Creating virtual environment..."
    python3 -m venv "$VENV_DIR"
fi

echo "Installing requirements..."
"$PY" -m pip install -q --disable-pip-version-check -r "$REQUIREMENTS"

echo "Starting agent on :$PORT..."
nohup "$PY" "$AGENT_DIR/RIMDocs_agent.py" >> "$LOG" 2>&1 &
echo $! > "$PID_FILE"
disown || true

for _ in $(seq 1 20); do
    sleep 1
    if curl -skf "$HEALTH" > /dev/null 2>&1; then
        echo "SUCCESS: agent is running on :$PORT (PID $(cat "$PID_FILE"))"
        exit 0
    fi
    if ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "FAILED: agent exited during startup. Last log lines:"
        tail -20 "$LOG"
        rm -f "$PID_FILE"
        exit 1
    fi
done

echo "FAILED: agent did not respond on :$PORT within 20s. Check $LOG"
exit 1
