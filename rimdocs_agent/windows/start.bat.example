@echo off
setlocal

set AGENT_DIR=%~dp0
set VENV_DIR=%AGENT_DIR%\venv
set PY=%VENV_DIR%\Scripts\python.exe
set PIP=%VENV_DIR%\Scripts\pip.exe
set REQUIREMENTS=%AGENT_DIR%requirements.txt
set LOG=%AGENT_DIR%agent.log

:: ── 1. Create venv if missing ─────────────────────────────────────
if not exist "%PY%" (
    echo Creating virtual environment...
    python -m venv "%VENV_DIR%"
    if errorlevel 1 (
        echo FAILED: Could not create virtual environment.
        pause
        exit /b 1
    )
    echo Virtual environment created.
)

:: ── 2. Install requirements ───────────────────────────────────────
if exist "%REQUIREMENTS%" (
    echo Installing requirements...
    "%PIP%" install -q -r "%REQUIREMENTS%"
    if errorlevel 1 (
        echo FAILED: pip install failed.
        pause
        exit /b 1
    )
    echo Requirements installed.
) else (
    echo WARNING: requirements.txt not found - skipping.
)

:: ── 3. Start the agent ────────────────────────────────────────────
echo Starting RIMDocs agent...
start /b "" "%PY%" "%AGENT_DIR%RIMDocs_agent.py" >> "%LOG%" 2>&1

:: ── 4. Wait and verify ────────────────────────────────────────────
echo Waiting for agent to start on :8443...
set /a COUNT=0

:WAIT_LOOP
timeout /t 1 /nobreak >nul
set /a COUNT+=1
curl -sf http://localhost:8443/health >nul 2>&1
if not errorlevel 1 (
    echo SUCCESS: RIMDocs agent is running on :8443
    exit /b 0
)
if %COUNT% LSS 12 goto WAIT_LOOP

echo FAILED: Agent did not respond on :8443 within 12s.
echo Check %LOG% for errors.
exit /b 1