@echo off
setlocal EnableDelayedExpansion

set "AGENT_DIR=%~dp0"
set "VENV_DIR=%AGENT_DIR%venv"
set "PY=%VENV_DIR%\Scripts\python.exe"
set "REQUIREMENTS=%AGENT_DIR%requirements.txt"
set "LOG=%AGENT_DIR%agent.log"
set "AGENT=%AGENT_DIR%epod_agent.py"
set "PORT=8090"
set "SCHEME=http"

if not exist "%AGENT_DIR%config.ini" (
    echo FAILED: config.ini not found in %AGENT_DIR%
    exit /b 1
)

for /f "usebackq tokens=1,* delims==" %%A in ("%AGENT_DIR%config.ini") do (
    set "KEY=%%A"
    set "KEY=!KEY: =!"
    set "VAL=%%B"
    if defined VAL set "VAL=!VAL: =!"
    if /i "!KEY!"=="PORT" if defined VAL set "PORT=!VAL!"
    if /i "!KEY!"=="SSL_CERTFILE" if defined VAL set "SCHEME=https"
)

:: Already running? Nothing to do.
curl -skf %SCHEME%://localhost:%PORT%/health >nul 2>&1
if not errorlevel 1 (
    echo Agent already running on :%PORT%
    exit /b 0
)

if not exist "%PY%" (
    echo Creating virtual environment...
    python -m venv "%VENV_DIR%" || (echo FAILED: could not create virtual environment & exit /b 1)
)

echo Installing requirements...
"%PY%" -m pip install -q --disable-pip-version-check -r "%REQUIREMENTS%" || (echo FAILED: pip install failed & exit /b 1)

echo Starting agent on :%PORT%...
start "" /b "%PY%" "%AGENT%" >> "%LOG%" 2>&1

set /a COUNT=0
:WAIT_LOOP
timeout /t 1 /nobreak >nul
set /a COUNT+=1
curl -skf %SCHEME%://localhost:%PORT%/health >nul 2>&1
if not errorlevel 1 (
    echo SUCCESS: agent is running on :%PORT%
    exit /b 0
)
if %COUNT% LSS 20 goto WAIT_LOOP

echo FAILED: agent did not respond on :%PORT% within 20s. Check %LOG%
exit /b 1
